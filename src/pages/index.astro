---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PortfolioCard from '../components/PortfolioCard.astro';

const portfolioItems = [
  { href: 'https://5tocode.dev/easybank',     src: '/img/easybank.png',            alt: 'Easybank project' },
  { href: 'https://miker60.sg-host.com/simaya', src: '/img/simaya_desktop.png',   alt: 'Simaya project' },
  { href: 'https://5tocode.dev/natours',      src: '/img/natours_desktop.png',      alt: 'Natours project' },
  { href: 'https://connected30a.com',         src: '/img/connected30a-desktop.png', alt: 'Connected30A project' },
  { href: 'https://5tocode.dev/trillo',       src: '/img/trillo_desktop.png',       alt: 'Trillo project' },
  { href: 'https://5tocode.dev/nexter',       src: '/img/nexter_desktop.png',       alt: 'Nexter project' },
  { href: 'https://lit-hollows-03470.herokuapp.com/campgrounds', src: '/img/yelpcamp.png', alt: 'Yelpcamp project' },
  { href: 'https://5tocode.dev/museumofcandy', src: '/img/museumofcandy.png',      alt: 'Museum of Candy project' },
  { href: 'https://5tocode.dev/colorgame',    src: '/img/colorgame.png',            alt: 'Color game project' },
  { href: 'https://5tocode.dev/simongame',    src: '/img/simongame.png',            alt: 'Simon game project' },
  { href: 'https://5tocode.dev/tindog',       src: '/img/tindog.png',               alt: 'Tindog project' },
  { href: 'https://5tocode.dev/drumkit',      src: '/img/drumkit.png',              alt: 'Drum kit project' },
];
---

<BaseLayout
  title="5toCode — Mike Roberts, Full Stack Web Developer"
  description="Full Stack Web Developer based in Watersound, Florida. I build beautiful, functional websites and web applications."
  fonts={true}
  icons={true}
>
  <SiteHeader />

  <!-- Introduction -->
  <section class="intro" id="home">
    <h1 class="section__title section__title--intro">
      Hi, I am <strong>Mike Roberts</strong>
    </h1>
    <p class="section__subtitle section__subtitle--intro">
      A Full Stack Web Developer
    </p>
    <img
      src="/img/mike_headshot_blackbg.jpg"
      alt="a picture of Mike smiling"
      class="intro__img"
    />
  </section>

  <!-- My Services -->
  <section class="my-services" id="services">
    <h2 class="section__title section__title--services">What I do</h2>
    <div class="services">
      <div class="service">
        <h3>Websites</h3>
        <p>
          Beautiful, mobile-friendly websites for businesses and organizations
          who want to make a great first impression on the Internet.
        </p>
      </div>
      <div class="service">
        <h3>Web Applications</h3>
        <p>
          Interactive web applications with optional API and database
          integration.
        </p>
      </div>
      <div class="service">
        <h3>E-Commerce</h3>
        <p>
          Seamless buying &amp; selling of your product/service over the
          Internet, using platforms such as Shopify, Square, and BigCommerce.
        </p>
      </div>
    </div>
    <a href="#work" class="btn btn--light">My Work</a>
  </section>

  <!-- About Me -->
  <section class="about-me" id="about">
    <h2 class="section__title section__title--about">Who I Am</h2>
    <p class="section__subtitle section__subtitle--about">
      A Web Developer based in Watersound, Florida
    </p>
    <div class="about-me__body">
      <p>
        I enjoy helping businesses and organizations create beautiful,
        functional websites and web applications that make a great impression
        on the Internet.
      </p>
      <p>
        What sets me apart from other web developers? I find out what my
        client's ideal outcomes look like, and work backwards from there to
        deliver on that vision.
      </p>
      <p>
        Out of the office you'll probably find me being dragged around our
        neighborhood by our three dogs, or in our garage which we've converted
        to a home gym.
      </p>
    </div>
    <img
      src="/img/IMG_2163_2.png"
      class="about-me__img"
      alt="Mike in Germany"
    />
  </section>

  <!-- My Work -->
  <section class="my-work" id="work">
    <h2 class="section__title section__title--work">My Work</h2>
    <p class="section__subtitle section__subtitle--work"></p>
    <div class="portfolio">
      {portfolioItems.map(item => (
        <PortfolioCard href={item.href} src={item.src} alt={item.alt} />
      ))}
    </div>
  </section>

  <SiteFooter />
</BaseLayout>

<style>
  /* Section base */
  section {
    padding: 5em 2em;
  }

  /* Typography scale */
  h1 { font-size: 3rem; }
  h2 { font-size: 2.25rem; }
  h3 { font-size: 1.25rem; }

  @media (min-width: 800px) {
    h1 { font-size: 4.5rem; }
    h2 { font-size: 3.75rem; }
    h3 { font-size: 1.5rem; }
  }

  h1, h2, h3 { line-height: 1; margin: 0; }

  .section__title { margin-bottom: 0.25em; }
  .section__title--intro { font-weight: 300; }
  .section__title--intro strong { display: block; }

  .section__subtitle {
    margin: 0;
    font-size: 1.25rem;
    color: #fff;
  }

  @media (min-width: 800px) {
    .section__subtitle { font-size: 1.5rem; }
  }

  .section__subtitle--intro,
  .section__subtitle--about {
    background: #2b70e4;
    padding: 0.25em 1em;
    font-family: 'Source Code Pro', monospace;
    margin-bottom: 1em;
  }

  .section__subtitle--work {
    color: #2b70e4;
    font-weight: 900;
    margin-bottom: 2em;
  }

  /* Button */
  .btn {
    display: inline-block;
    padding: 0.5em 2.5em;
    background: #2b70e4;
    color: #303030;
    text-decoration: none;
    cursor: pointer;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 900;
    transition: transform 200ms ease-in-out;
  }
  .btn:hover { transform: scale(1.1); }
  .btn--light { color: #fff; }

  /* Intro section — CSS Grid named areas */
  .intro { position: relative; }
  .intro__img {
    box-shadow: 0.25em 0.25em 0.75em rgba(0,0,0,0.25),
                0.125em 0.125em 0.25em rgba(0,0,0,0.15);
  }
  .section__subtitle--intro { display: inline-block; }

  @media (min-width: 600px) {
    .intro {
      display: grid;
      width: min-content;
      margin: 0 auto;
      grid-column-gap: 1em;
      grid-template-areas:
        "img title"
        "img subtitle";
      grid-template-columns: min-content max-content;
    }
    .intro__img {
      grid-area: img;
      min-width: 250px;
      position: relative;
      z-index: 2;
    }
    .section__subtitle--intro {
      align-self: start;
      grid-column: -1 / 1;
      grid-row: 2;
      text-align: right;
      position: relative;
      left: -1.5em;
      width: calc(100% + 1.5em);
    }
  }

  /* My Services section */
  .my-services {
    background-color: #303030;
    background-image: url('/img/services-bg.jpg');
    background-size: cover;
    background-blend-mode: overlay;
    color: #fff;
    text-align: center;
  }
  .section__title--services {
    color: #2b70e4;
    position: relative;
  }
  .section__title--services::after {
    content: '';
    display: block;
    width: 2em;
    height: 1px;
    margin: 0.5em auto 1em;
    background: #fff;
    opacity: 0.25;
  }
  .services { margin-bottom: 4em; }
  .service { max-width: 500px; margin: 0 auto; }

  @media (min-width: 800px) {
    .services {
      display: flex;
      max-width: 1000px;
      margin-right: auto;
      margin-left: auto;
    }
    .service + .service { margin-left: 2em; }
  }

  /* About Me section — CSS Grid named areas */
  .about-me {
    max-width: 1000px;
    margin: 0 auto;
  }
  .about-me__img {
    box-shadow: 0.25em 0.25em 0.75em rgba(0,0,0,0.25),
                0.125em 0.125em 0.25em rgba(0,0,0,0.15);
  }

  @media (min-width: 600px) {
    .about-me {
      display: grid;
      grid-template-columns: 1fr 200px;
      grid-template-areas:
        "title img"
        "subtitle img"
        "text img";
      grid-column-gap: 2em;
    }
    .section__title--about   { grid-area: title; }
    .about-me__body          { grid-area: text; }
    .section__subtitle--about {
      grid-column: 1 / -1;
      grid-row: 2;
      position: relative;
      left: -1em;
      width: calc(100% + 2em);
      padding-left: 1em;
      padding-right: calc(200px + 4em);
    }
    .about-me__img {
      grid-area: img;
      position: relative;
      z-index: 2;
    }
  }

  /* My Work section */
  .my-work {
    background-color: #303030;
    color: #fff;
    text-align: center;
  }

  /* Portfolio grid — auto-fit */
  .portfolio {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 10px;
  }

  .portfolio__item {
    background: #2b70e4;
    overflow: hidden;
    display: block;
  }

  .portfolio__img {
    transition:
      transform 750ms cubic-bezier(0.5, 0, 0.5, 1),
      opacity 250ms linear;
    width: 100%;
  }

  .portfolio__item:focus { position: relative; z-index: 2; }

  .portfolio__img:hover,
  .portfolio__item:focus .portfolio__img {
    transform: scale(1.2);
    opacity: 0.5;
  }
</style>
