---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const posts = (await getCollection('writing'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Mike Roberts — Cloud Security, AI, Builder"
  description="Engineering Manager at Google. Cloud security practitioner. Builder of AI-assisted iOS apps. Writing about AI and cybersecurity. Based in Atlanta."
>
  <div class="page-wrap">

    <!-- Ambient decorative background (grid + gradient blob) -->
    <div class="ambient-bg" aria-hidden="true">
      <div class="ambient-grid"></div>
      <div class="ambient-blob"></div>
    </div>

    <SiteHeader />

    <main class="main-content">

      <!-- ── Hero / Who I Am ───────────────────────────────────── -->
      <section class="hero" id="who-i-am">
        <div class="hero__content tech-line">

          <div class="hero__name-block">
            <p class="hero__hi">Hi, I'm</p>
            <h1 class="hero__name">Mike Roberts</h1>
          </div>

          <div class="terminal-block glass-panel">
            <div class="terminal-text">
              <span class="terminal-prompt">&gt;</span>
              <span>
                Customer Engineering Manager @ Google<br />
                cloud security · ai · builder
              </span>
            </div>
          </div>

          <div class="hero__body">
            <div class="location-badge">based in atlanta, georgia</div>
            <p>
              I lead a team of Customer Engineers at Google supporting Wiz, the cloud security
              platform Google acquired earlier this year. I've worked in technology for two
              decades, with a focus on cloud security for the past several years.
            </p>
            <p>
              Outside of work, I use AI coding tools to build apps such as a privacy-first interval
              timer called TrainIQ and a strength training app called StrengthIQ. Both are built
              around a simple rule: your data stays on your device.
            </p>
            <p>
              I write about AI, security, and the patterns I observe at the intersection of both.
              I'm increasingly interested in teaching — specifically at the intersection of AI and
              cybersecurity, where I think the knowledge gap is widest and growing fastest.
            </p>
          </div>
        </div>

        <div class="hero__deco" aria-hidden="true">
          <div class="hero__deco-blob"></div>
        </div>
      </section>

      <!-- ── What I Build ──────────────────────────────────────── -->
      <section class="apps-section" id="what-i-build">
        <div class="apps-header">
          <h2 class="section-title">What I Build</h2>
          <p class="section-sub">Apps for people who take privacy seriously</p>
        </div>

        <div class="app-cards">
          <a href="/TrainIQ/" class="app-card glass-card">
            <span class="app-card__icon material-symbols-outlined" aria-hidden="true">timer</span>
            <h3 class="app-card__name">TrainIQ</h3>
            <p class="app-card__desc">A privacy-first interval timer. No ads, no tracking, all on-device.</p>
            <span class="app-card__cta">
              VIEW APP
              <span class="material-symbols-outlined app-card__arrow" aria-hidden="true">arrow_forward</span>
            </span>
          </a>

          <a href="/StrengthIQ/" class="app-card glass-card">
            <span class="app-card__icon material-symbols-outlined" aria-hidden="true">fitness_center</span>
            <h3 class="app-card__name">StrengthIQ</h3>
            <p class="app-card__desc">A strength training log. Workout data never leaves your device.</p>
            <span class="app-card__cta">
              VIEW APP
              <span class="material-symbols-outlined app-card__arrow" aria-hidden="true">arrow_forward</span>
            </span>
          </a>
        </div>
      </section>

      <!-- ── Writing ───────────────────────────────────────────── -->
      <section class="writing-section tech-line" id="writing">
        <div class="writing-header">
          <h2 class="section-title">Writing</h2>
          <p class="section-sub">Notes on AI, security, and building things.</p>
        </div>

        {posts.length === 0 ? (
          <p class="writing-empty">No articles yet — check back soon.</p>
        ) : (
          <div class="writing-list">
            {posts.map(post => {
              const date = post.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric', month: 'long', day: 'numeric',
              });
              return (
                <a href={`/writing/${post.id}/`} class="writing-item">
                  <time class="writing-item__date" datetime={post.data.pubDate.toISOString()}>
                    {date}
                  </time>
                  <h3 class="writing-item__title">{post.data.title}</h3>
                  <p class="writing-item__desc">{post.data.description}</p>
                  <div class="writing-item__rule" aria-hidden="true"></div>
                </a>
              );
            })}
          </div>
        )}

        <a href="/writing/" class="see-all-link">
          See all writing
          <span class="material-symbols-outlined see-all-link__arrow" aria-hidden="true">arrow_forward</span>
        </a>
      </section>

    </main>

    <SiteFooter />
  </div>
</BaseLayout>

<style>
  /* ── Page wrapper ─────────────────────────────────────────────── */
  .page-wrap {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    padding-top: 80px;
    position: relative;
  }

  /* ── Ambient background layers ────────────────────────────────── */
  .ambient-bg {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .ambient-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  .ambient-blob {
    position: absolute;
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 600px;
    background: radial-gradient(ellipse at center, var(--blob-color), transparent 70%);
    border-radius: 50%;
    filter: blur(80px);
  }

  /* ── Main content (above ambient bg) ─────────────────────────── */
  .main-content {
    flex: 1;
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
    padding: 3rem 1.25rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 4rem;                /* tighter on mobile */
    position: relative;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .main-content {
      padding: 5rem 1.5rem 3rem;
      gap: 6rem;              /* restore full gap on desktop */
    }
  }

  /* ── Shared section typography ────────────────────────────────── */
  .section-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-heading);
    margin: 0 0 0.5rem;
    line-height: 1.1;
  }

  @media (min-width: 768px) {
    .section-title { font-size: 2.25rem; }
  }

  .section-sub {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin: 0;
    text-transform: uppercase;
  }

  /* ── Hero ─────────────────────────────────────────────────────── */
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
    min-height: 40vh;         /* shorter on mobile */
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 7fr 3fr;
      gap: 3rem;
      min-height: 55vh;
    }
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-left: 1.5rem;
  }

  .hero__name-block {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .hero__hi {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-muted);
    margin: 0;
  }

  .hero__name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.5rem, 7vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--name-color);
    text-shadow: 0 0 40px var(--name-glow);
    margin: 0;
  }

  /* Terminal block */
  .terminal-block {
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--accent);
    border-radius: 2px;
    display: block;           /* block so long text wraps on narrow screens */
    max-width: 100%;
    box-sizing: border-box;
  }

  .terminal-text {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875rem;
    color: var(--text-dim);
    line-height: 1.7;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin: 0;
  }

  .terminal-prompt {
    color: var(--accent);
    font-weight: 700;
    flex-shrink: 0;
  }

  /* Hero body + badge */
  .hero__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--text-muted);
    font-family: 'Inter', sans-serif;
    font-size: 1.0625rem;
    line-height: 1.7;
    max-width: 660px;
  }

  .hero__body p { margin: 0; }

  .location-badge {
    display: inline-block;
    align-self: flex-start;
    background: var(--accent-subtle-bg);
    color: var(--accent);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--accent-subtle-bd);
    border-radius: 2px;
    margin-bottom: 0.25rem;
  }

  /* Decorative blob (desktop) */
  .hero__deco {
    display: none;
    justify-content: center;
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero__deco { display: flex; }
  }

  .hero__deco-blob {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at center, var(--accent-subtle-bg), transparent 70%);
    filter: blur(30px);
  }

  /* ── Apps Section ─────────────────────────────────────────────── */
  .apps-section {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 2.5rem 1.25rem;
    margin: 0 -1.25rem;
    background: var(--bg-section);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  @media (min-width: 768px) {
    .apps-section {
      gap: 3rem;
      padding: 4rem 3rem;
      margin: 0 -1.5rem;
    }
  }

  .apps-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .app-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 860px;
    margin: 0 auto;
    width: 100%;
  }

  @media (min-width: 600px) {
    .app-cards { grid-template-columns: 1fr 1fr; }
  }

  .app-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2rem;
    border-radius: 4px;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
  }

  .app-card__icon {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-size: 4rem;
    color: var(--accent);
    opacity: 0.07;
    transition: opacity 0.3s;
    pointer-events: none;
    font-variation-settings: 'FILL' 0, 'wght' 200;
  }

  .app-card:hover .app-card__icon { opacity: 0.18; }

  .app-card__name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-heading);
    margin: 0;
    position: relative;
    z-index: 1;
  }

  .app-card__desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
    flex-grow: 1;
    position: relative;
    z-index: 1;
  }

  .app-card__cta {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 0.75rem;
    position: relative;
    z-index: 1;
    transition: color 0.2s;
  }

  .app-card:hover .app-card__cta { color: var(--accent-hi); }

  .app-card__arrow { font-size: 1rem; }

  /* ── Writing Section ──────────────────────────────────────────── */
  .writing-section {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-left: 1.5rem;
    max-width: 720px;
  }

  .writing-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .writing-list {
    display: flex;
    flex-direction: column;
  }

  .writing-item {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 1.5rem 0;
  }

  .writing-item__date {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-dim);
    opacity: 0.8;
    margin-bottom: 0.5rem;
  }

  .writing-item__title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-heading);
    margin: 0 0 0.5rem;
    line-height: 1.3;
    transition: color 0.2s;
  }

  .writing-item:hover .writing-item__title { color: var(--accent); }

  .writing-item__desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    color: var(--text-muted);
    margin: 0;
    line-height: 1.6;
  }

  .writing-item__rule {
    height: 1px;
    background: var(--border);
    margin-top: 1.5rem;
    transition: background 0.2s;
  }

  .writing-item:hover .writing-item__rule { background: var(--accent-subtle-bd); }

  .writing-empty {
    color: var(--text-muted);
    font-style: italic;
  }

  .see-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s;
  }

  .see-all-link:hover { color: var(--accent-hi); }

  .see-all-link__arrow { font-size: 1rem; }
</style>
