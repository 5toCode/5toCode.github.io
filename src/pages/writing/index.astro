---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const posts = (await getCollection('writing')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Writing | Mike Roberts"
  description="Notes on AI, security, and building things at the intersection of cloud and code."
>
  <div class="writing-page">
    <SiteHeader />

    <main class="writing-main">
      <div class="writing-inner tech-line">
        <h1 class="writing-heading">Writing</h1>
        <p class="writing-sub">Notes on AI, security, and building things.</p>

        {posts.length === 0 && (
          <p class="empty">No articles yet — check back soon.</p>
        )}

        <ol class="post-list">
          {posts.map(post => {
            const date = post.data.pubDate.toLocaleDateString('en-US', {
              year: 'numeric', month: 'long', day: 'numeric',
            });
            return (
              <li>
                <a href={`/writing/${post.id}/`} class="post-link">
                  <time class="post-date" datetime={post.data.pubDate.toISOString()}>
                    {date}
                  </time>
                  <h2 class="post-title">{post.data.title}</h2>
                  <p class="post-desc">{post.data.description}</p>
                  <div class="post-rule" aria-hidden="true"></div>
                </a>
              </li>
            );
          })}
        </ol>

        <p class="rss-note">
          <a href="/rss.xml" class="rss-link">RSS feed</a>
        </p>
      </div>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>

<style>
  .writing-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    padding-top: 80px;
  }

  .writing-main {
    flex: 1;
    padding: 4rem 1.5rem 5rem;
  }

  .writing-inner {
    max-width: 720px;
    margin: 0 auto;
    padding-left: 1.5rem;
  }

  .writing-heading {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.5rem, 7vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--text-heading);
    margin: 0 0 0.375em;
  }

  .writing-sub {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin: 0 0 3rem;
    text-transform: uppercase;
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .post-link {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 1.5rem 0;
  }

  .post-link:hover .post-title { color: var(--accent); }
  .post-link:hover .post-rule  { background: var(--accent-subtle-bd); }

  .post-date {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--text-dim);
    opacity: 0.8;
    margin-bottom: 0.5rem;
  }

  .post-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--text-heading);
    margin: 0 0 0.5rem;
    transition: color 0.2s;
  }

  .post-desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .post-rule {
    height: 1px;
    background: var(--border);
    margin-top: 1.5rem;
    transition: background 0.2s;
  }

  .empty {
    color: var(--text-muted);
    font-style: italic;
  }

  .rss-note {
    margin-top: 3rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .rss-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }

  .rss-link:hover {
    color: var(--accent-hi);
    text-decoration: underline;
  }
</style>
