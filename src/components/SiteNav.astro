---
// Static nav links. Add items here to update both nav and mobile overlay.
const links = [
  { href: '#home',     label: 'Home' },
  { href: '#services', label: 'My Services' },
  { href: '#about',    label: 'About Me' },
  { href: '#work',     label: 'My Work' },
  { href: '/writing/', label: 'Writing' },
];
---

<nav class="nav">
  <ul class="nav__list">
    {links.map(({ href, label }) => (
      <li class="nav__item">
        <a href={href} class="nav__link">{label}</a>
      </li>
    ))}
  </ul>
</nav>
