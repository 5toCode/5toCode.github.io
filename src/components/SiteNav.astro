---
// Updated nav links — matches SiteHeader.astro
const links = [
  { href: '#who-i-am',     label: 'Who I Am' },
  { href: '#what-i-build', label: 'What I Build' },
  { href: '/writing/',     label: 'Writing' },
  { href: '#contact',      label: 'Contact' },
];
---

<nav class="nav" aria-label="Main navigation">
  <ul class="nav__list">
    {links.map(({ href, label }) => (
      <li class="nav__item">
        <a href={href} class="nav__link">{label}</a>
      </li>
    ))}
  </ul>
</nav>
