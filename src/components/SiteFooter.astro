---
const socials = [
  { href: 'https://codepen.io/5tocode',    icon: 'fab fa-codepen',     label: 'CodePen' },
  { href: 'https://linkedin.com/in/5tocode', icon: 'fab fa-linkedin-in', label: 'LinkedIn' },
  { href: 'https://twitter.com/5tocode',   icon: 'fab fa-twitter',     label: 'Twitter' },
  { href: 'https://github.com/5toCode',    icon: 'fab fa-github',      label: 'GitHub' },
];
---

<footer class="footer">
  <a href="mailto:mike@5tocode.dev" class="footer__link">mike@5tocode.dev</a>
  <ul class="social-list">
    {socials.map(({ href, icon, label }) => (
      <li class="social-list__item">
        <a href={href} class="social-list__link" aria-label={label}>
          <i class={icon}></i>
        </a>
      </li>
    ))}
  </ul>
</footer>

<style>
  .footer {
    background: #111;
    color: #2b70e4;
    text-align: center;
    padding: 2.5em 0;
    font-size: 1.25rem;
  }

  @media (min-width: 800px) {
    .footer { font-size: 1.5rem; }
  }

  .footer a {
    color: inherit;
    text-decoration: none;
  }

  .footer__link {
    font-weight: 900;
    transition: all 200ms;
  }

  .footer__link:hover,
  .social-list__link:hover {
    opacity: 0.7;
  }

  .footer__link:hover {
    text-decoration: underline;
  }

  .social-list {
    list-style: none;
    display: flex;
    justify-content: center;
    margin: 2em 0 0;
    padding: 0;
  }

  .social-list__item {
    margin: 0 0.5em;
  }

  .social-list__link {
    padding: 0.5em;
  }
</style>
