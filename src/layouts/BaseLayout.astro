---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  fonts?: boolean;  // kept for backward compat; fonts always load now
  icons?: boolean;  // kept for backward compat; icons always load now
}

const {
  title,
  description = 'Mike Roberts — Engineering Manager, Cloud Security at Google. Builder of AI-assisted iOS apps. Writing about AI and cybersecurity.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts: Space Grotesk (headings) · JetBrains Mono (tech labels) · Inter (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Material Symbols (for UI icons) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap"
      rel="stylesheet"
    />

    <!-- Font Awesome 6 (for social brand icons) -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
      crossorigin="anonymous"
    />

    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
