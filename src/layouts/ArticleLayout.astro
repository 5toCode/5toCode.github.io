---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
}

const { title, description, pubDate } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} | Mike Roberts`} description={description} fonts={true}>
  <div class="max-w-[720px] mx-auto px-8 py-20">
    <a
      href="/writing/"
      class="inline-block mb-8 text-sm font-bold uppercase tracking-widest text-[#2b70e4] hover:opacity-70 transition-opacity"
    >
      ← All Articles
    </a>

    <header class="mb-10">
      <time
        datetime={pubDate.toISOString()}
        class="block text-sm text-gray-500 mb-3 font-mono"
      >
        {formattedDate}
      </time>
      <h1 class="text-4xl md:text-5xl font-black leading-tight text-[#303030] mb-4">
        {title}
      </h1>
      <p class="text-lg text-gray-600 leading-relaxed">{description}</p>
    </header>

    <hr class="border-gray-200 mb-10" />

    <article class="prose max-w-none text-[#303030] leading-relaxed [&_h2]:text-3xl [&_h2]:font-black [&_h2]:mt-10 [&_h2]:mb-4 [&_h3]:text-2xl [&_h3]:font-bold [&_h3]:mt-8 [&_h3]:mb-3 [&_p]:mb-5 [&_a]:text-[#2b70e4] [&_a]:underline [&_code]:font-mono [&_code]:bg-gray-100 [&_code]:px-1 [&_code]:rounded [&_pre]:bg-gray-900 [&_pre]:text-gray-100 [&_pre]:p-5 [&_pre]:rounded [&_pre]:overflow-x-auto [&_ul]:list-disc [&_ul]:ml-6 [&_ul]:mb-5 [&_ol]:list-decimal [&_ol]:ml-6 [&_ol]:mb-5 [&_blockquote]:border-l-4 [&_blockquote]:border-[#2b70e4] [&_blockquote]:pl-5 [&_blockquote]:italic [&_blockquote]:text-gray-600">
      <slot />
    </article>
  </div>
</BaseLayout>
