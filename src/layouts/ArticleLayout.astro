---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
}

const { title, description, pubDate } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} | Mike Roberts`} description={description}>
  <div class="article-page">
    <div class="article-wrap">
      <a href="/writing/" class="back-link">← All Articles</a>

      <header class="article-header">
        <time datetime={pubDate.toISOString()} class="article-date">
          {formattedDate}
        </time>
        <h1 class="article-title">{title}</h1>
        <p class="article-desc">{description}</p>
      </header>

      <hr class="article-rule" />

      <article class="article-body">
        <slot />
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  /* ── Page chrome ─────────────────────────────────────────────── */
  .article-page {
    padding: 2.5rem 0 5rem;
  }

  .article-wrap {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s;
  }

  .back-link:hover { color: var(--accent-hi); }

  /* ── Article header ──────────────────────────────────────────── */
  .article-header { margin-bottom: 2.5rem; }

  .article-date {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .article-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.875rem, 5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--text-heading);
    margin: 0 0 1rem;
  }

  .article-desc {
    font-family: 'Inter', sans-serif;
    font-size: 1.125rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .article-rule {
    border: none;
    border-top: 1px solid var(--border-line);
    margin-bottom: 2.5rem;
  }

  /* ── Article body (prose styles via :global) ─────────────────── */
  .article-body {
    font-family: 'Inter', sans-serif;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text-muted);
  }

  /* Paragraphs */
  .article-body :global(p) {
    margin: 0 0 1.5rem;
    color: var(--text-muted);
  }

  /* Headings */
  .article-body :global(h2) {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-heading);
    margin: 2.5rem 0 1rem;
    line-height: 1.2;
  }

  .article-body :global(h3) {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--text-heading);
    margin: 2rem 0 0.75rem;
    line-height: 1.25;
  }

  /* Links */
  .article-body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s;
  }

  .article-body :global(a:hover) { color: var(--accent-hi); }

  /* Strong / bold */
  .article-body :global(strong) {
    font-weight: 700;
    color: var(--text-heading);
  }

  /* Inline code */
  .article-body :global(code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.875em;
    background: var(--bg-section);
    color: var(--accent);
    padding: 0.15em 0.4em;
    border-radius: 3px;
    border: 1px solid var(--border);
  }

  /* Code blocks */
  .article-body :global(pre) {
    background: var(--bg-surface);
    border: 1px solid var(--border-line);
    color: var(--text);
    padding: 1.25rem;
    border-radius: 4px;
    overflow-x: auto;
    font-size: 0.9rem;
    margin: 0 0 1.5rem;
  }

  .article-body :global(pre code) {
    background: transparent;
    color: inherit;
    padding: 0;
    border: none;
    font-size: inherit;
  }

  /* Lists */
  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
    color: var(--text-muted);
  }

  .article-body :global(ul) { list-style: disc; }
  .article-body :global(ol) { list-style: decimal; }
  .article-body :global(li) { margin-bottom: 0.4rem; }

  /* Blockquote */
  .article-body :global(blockquote) {
    border-left: 4px solid var(--accent);
    padding: 0.75rem 1.25rem;
    margin: 0 0 1.5rem;
    background: var(--accent-subtle-bg);
    border-radius: 0 4px 4px 0;
    font-style: italic;
    color: var(--text-muted);
  }

  /* Horizontal rule */
  .article-body :global(hr) {
    border: none;
    border-top: 1px solid var(--border-line);
    margin: 2.5rem 0;
  }

  /* Images */
  .article-body :global(img) {
    display: block;
    max-width: 100%;
    max-height: 650px;
    width: auto;
    height: auto;
    margin: 2.5rem auto;
    border-radius: 8px;
    box-shadow: 0 6px 30px rgba(0, 0, 0, 0.25);
    border: 1px solid var(--border);
  }
</style>
